# Model-Builder 环境变量模板——复制为 .env 后填入真实值；.env 已被 .gitignore 排除，绝不提交

# ── 云 LLM 密钥（数据合成 / AI 实验报告用；不配则相关功能返回明确缺钥提示）──
QWEN_KEY=
DEEPSEEK_KEY=
GLM_KEY=
KIMI_KEY=
VOLCANO_KEY=  # 火山引擎（格式: id:secret）

# ── 训练环境（训练机上的目录与工具路径）──
# 训练环境根：train_rlcd.py / kev_rlcd_bridge.py / venv / models 所在目录
TRAINING_ROOT=/path/to/training-env
# 任务工作目录（data/jobs/logs/run/saves；默认 TRAINING_ROOT/ai-harbor-training）
TRAINING_WORKDIR=
# llamafactory-cli 路径（默认按 TRAINING_ROOT/venv 推导，Windows: venv/Scripts/...，Linux: venv/bin/...）
TRAINING_CLI=

# ── 数据集导入白名单（分号分隔；默认项目 data/ + TRAINING_ROOT）──
DATASET_IMPORT_ROOTS=

# ── 服务 ──
HOST=127.0.0.1
PORT=3000
